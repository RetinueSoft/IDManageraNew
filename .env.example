# Copy this file to .env (gitignored) and fill in real values before running
# `docker compose up` on a server. Never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-real-password

# Signs the login tokens. At least 32 characters, random; keep it secret. Changing it logs
# everyone out.
JWT_KEY=change-me-to-a-long-random-secret-of-32-or-more-characters

# The server's actual public IP or domain -- used for the API's CORS origin (the UI itself reaches
# the API through its own address, so it needs nothing). Leave unset for local dev (defaults to
# localhost).
# IDCM_PUBLIC_HOST=203.0.113.10

# The Super Admin created on the first start of a fresh database (defaults shown). Change the
# password after the first login.
# SEED_ADMIN_PHONE=9943135008
# SEED_ADMIN_PASSWORD=Red@123

# Optional: pin a specific image tag instead of :latest -- e.g. for a
# rollback, or a controlled deploy that doesn't move the moment a new
# :latest is pushed.
# IDCM_API_IMAGE=ghcr.io/retinuesoft/idcardmanager-api:abc1234
# IDCM_UI_IMAGE=ghcr.io/retinuesoft/idcardmanager-ui:abc1234
