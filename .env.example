# Settings for the server. update.sh creates /root/common/env/idcardmanager.env from this file on the first run
# and later adds any new settings from here (your values are never overwritten). It holds passwords: never commit it.
# Shared settings (GitHub token, Azure backup URL) are in /root/common, see RetinueSoft/VpsSetup.

# The database password.
POSTGRES_PASSWORD=

# Signs the login tokens. update.sh fills in a random one when empty. Changing it logs everyone out.
JWT_KEY=

# How long a login lasts, in minutes, counted from the moment of login.
JWT_EXPIRY_MINUTES=30

# The server's public IP or domain, for the API's CORS origin (http://<this>:5144).
IDCM_PUBLIC_HOST=

# The Super Admin created on the first start of a fresh database. Change the password after the first login.
SEED_ADMIN_PHONE=9943135008
SEED_ADMIN_PASSWORD=Red@123

# Ports on the server (127.0.0.1 only). The common Caddy serves :5144 / :5165 from them:
# keep them equal to VpsSetup caddy/sites/idcardmanager.caddy.
UI_HOST_PORT=15144
API_HOST_PORT=15165
# Port on the server itself (127.0.0.1 only) for SSH-tunnel access with pgAdmin/DBeaver.
POSTGRES_HOST_PORT=5433

# RAM limit per container (e.g. 512m, 1g). Total for this app by default: about 1.3 GB.
POSTGRES_MEM_LIMIT=512m
API_MEM_LIMIT=768m
UI_MEM_LIMIT=64m

# Server time zone: only affects log timestamps.
TZ=UTC

# Image version from ghcr.io: "latest" or a build tag like sha-1a2b3c4 (set by update.sh).
APP_IMAGE_TAG=latest
