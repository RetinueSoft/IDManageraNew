# Settings for the server. update.sh creates /root/common/env/idcardmanager.env from this file on the first run
# and later adds any new settings from here (your values are never overwritten). It holds passwords: never commit it.
# Shared settings (database password, GitHub token, Azure backup URL) are in /root/common/.env, see RetinueSoft/VpsSetup.
# The database password is POSTGRES_PASSWORD in /root/common/.env, shared by all apps.

# Signs the login tokens. update.sh fills in a random one when empty. Changing it logs everyone out.
JWT_KEY=

# How long a login lasts, in minutes, counted from the moment of login.
JWT_EXPIRY_MINUTES=30

# The server's public IP or domain, for the API's CORS origin (https://<this>:8082).
IDCM_PUBLIC_HOST=

# The Super Admin created on the first start of a fresh database. Change the password after the first login.
SEED_ADMIN_PHONE=9943135008
SEED_ADMIN_PASSWORD=Red@123

# Ports on the server (127.0.0.1 only). The common Caddy serves https://<ip>:8082 / :8182 from them:
# keep them equal to VpsSetup caddy/sites/idcardmanager.caddy.
UI_HOST_PORT=18082
API_HOST_PORT=18182
# Port on the server itself (127.0.0.1 only) for SSH-tunnel access with pgAdmin/DBeaver.
POSTGRES_HOST_PORT=5433

# Memory. The apps keep themselves small; the limits are only a safety net (a container above its limit is
# stopped and restarted by Docker). Normal use: api about 500-700 MB, postgres about 90-130 MB, ui about 1-10 MB.
POSTGRES_MEM_LIMIT=512m
API_MEM_LIMIT=1g
UI_MEM_LIMIT=64m
# PostgreSQL's shared cache (its biggest memory user).
POSTGRES_SHARED_BUFFERS=128MB
# How hard .NET works to keep its memory small, 0-9 (higher = less RAM, a little more CPU).
API_GC_CONSERVE_MEMORY=5

# Server time zone: only affects log timestamps.
TZ=UTC

# Image version from ghcr.io: "latest" or a build tag like sha-1a2b3c4 (set by update.sh).
APP_IMAGE_TAG=latest
